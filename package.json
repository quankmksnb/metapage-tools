{
  "name": "metapage-tools",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w @metapage/api",
    "dev:web": "npm run dev -w @metapage/web",
    "build": "npm run build -w @metapage/api && npm run build -w @metapage/web",
    "lint": "npm run lint -w @metapage/api && npm run lint -w @metapage/web && biome check .",
    "format": "biome format --write .",
    "test": "npm run test -w @metapage/api",
    "db:migrate": "npm run db:migrate -w @metapage/api",
    "db:generate": "npm run db:generate -w @metapage/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
